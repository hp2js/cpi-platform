{
  "name": "@cpi/contracts",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cpi/tsconfig": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js",
      "default": "./dist/fixtures/index.js"
    },
    "./scoring-fixtures": {
      "types": "./dist/scoring-fixtures/index.d.ts",
      "import": "./dist/scoring-fixtures/index.js",
      "default": "./dist/scoring-fixtures/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "fixtures": [
        "dist/fixtures/index.d.ts"
      ],
      "scoring-fixtures": [
        "dist/scoring-fixtures/index.d.ts"
      ]
    }
  }
}
