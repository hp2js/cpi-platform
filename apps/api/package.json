{
  "name": "@cpi/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onFirstSuccess \"node --watch --env-file-if-exists=../../.env dist/main.js\"",
    "dev:container": "concurrently --kill-others --names contracts,api \"pnpm --filter @cpi/contracts dev\" \"pnpm dev\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsc -p tsconfig.build.json && INTEGRATION=1 vitest run --no-file-parallelism --test-timeout=30000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/database/seed.ts",
    "storage:migrate": "tsx --env-file-if-exists=../../.env src/storage/maintenance.ts migrate",
    "storage:gc": "tsx --env-file-if-exists=../../.env src/storage/maintenance.ts gc",
    "user:invite-admin": "tsx --env-file-if-exists=../../.env src/auth/invite-admin.ts",
    "assistant:evaluate": "tsx --env-file-if-exists=../../.env src/assistant/evaluate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@cpi/contracts": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@react-email/render": "2.1.0",
    "@smithy/node-http-handler": "4.12.1",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.0",
    "read-excel-file": "9.3.10",
    "reflect-metadata": "0.2.2",
    "resend": "6.32.0",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cpi/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.11",
    "tsc-watch": "7.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
