{
  "name": "@cpi/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/database/seed.ts"
  },
  "dependencies": {
    "@cpi/contracts": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "drizzle-orm": "0.45.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cpi/tsconfig": "workspace:*",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  }
}
