{
  "name": "cpi-platform",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.32.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cpi/contracts build && pnpm --parallel --filter @cpi/contracts --filter @cpi/api --filter @cpi/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @cpi/contracts build && pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "lint": "pnpm --filter @cpi/contracts build && eslint .",
    "test": "pnpm --filter @cpi/contracts build && pnpm -r test",
    "test:integration": "pnpm --filter @cpi/contracts build && pnpm --filter @cpi/api test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-compiler.mjs",
    "services:up": "docker compose up -d --build --wait postgres redis minio && docker compose run --build --rm minio-init",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:prod": "docker compose -f compose.yaml -f compose.production.yaml up -d --build --wait",
    "db:generate": "pnpm --filter @cpi/api db:generate",
    "db:migrate": "pnpm --filter @cpi/api db:migrate",
    "db:seed": "pnpm --filter @cpi/api db:seed",
    "db:reset": "node scripts/reset-local.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "docker:dev": "docker compose up --build --watch",
    "test:e2e": "playwright test",
    "test:e2e:prod": "CPI_PRODUCTION=true playwright test",
    "release": "release-it",
    "release:dry": "release-it --dry-run --ci",
    "storage:migrate": "pnpm --filter @cpi/api storage:migrate",
    "storage:gc": "pnpm --filter @cpi/api storage:gc"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "release-it": "21.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
