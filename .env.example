# Local development only. Docker database/cache ports are loopback-bound.
NODE_ENV=development
API_PORT=3001
POSTGRES_USER=cpi_local
POSTGRES_PASSWORD=cpi_local_only
# Resets, the scripted year and pnpm db:seed replace every record, so they only run on a
# database whose name ends in _demo (HP2-42).
POSTGRES_DB=cpi_demo
DATABASE_URL=postgresql://cpi_local:cpi_local_only@127.0.0.1:15432/cpi_demo
REDIS_URL=redis://127.0.0.1:16379

# Local MinIO: app credentials are restricted to the private file bucket.
MINIO_ROOT_USER=cpi-local-admin
MINIO_ROOT_PASSWORD=cpi-local-admin-only
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=cpi-files
S3_ACCESS_KEY_ID=cpi-local
S3_SECRET_ACCESS_KEY=cpi-local-files-only
S3_FORCE_PATH_STYLE=true
S3_PREFIX=evidence/

# Account emails (temporary passwords, sign-in codes, password resets) go through Resend when
# RESEND_API_KEY is set; empty keeps them in the local email sink (Administration → Notifications).
# onboarding@resend.dev only reaches the Resend account's own address; verify a domain for others.
RESEND_API_KEY=
# Workflow notification emails always go to the email sink. The delivery worker retries a failed
# one after these waits (milliseconds), then lists it in the failure queue.
DELIVERY_RETRY_DELAYS_MS=30000,120000
# Demo mode seeds the fictional year, offers one-click demo accounts and accepts only
# @example.invalid sign-in addresses. false seeds a clean cycle (no institutions or people) and
# accepts real addresses; ADMIN_EMAIL is then required.
DEMO_MODE=true
# Outside demo mode, file uploads are refused until this is true: set it only once malware
# scanning, quarantine and a production review are approved for real documents.
REAL_DOCUMENT_UPLOADS=false
# Seeded in both modes and emailed a temporary password when first created; kept across resets.
ADMIN_EMAIL=
ADMIN_NAME=Platform administrator
EMAIL_FROM=CPI Platform <onboarding@resend.dev>

# Evidence assistant (PRD §14, docs/assistant.md). Administrators turn it on in the console.
# deterministic: rules inside the platform, no model or network (tests, CI, offline demo).
# openai-compatible: a chat endpoint, e.g. Ollama at http://127.0.0.1:11434/v1 or OpenAI at
# https://api.openai.com/v1 (or any other hosted API with an OpenAI-compatible endpoint).
ASSISTANT_PROVIDER=deterministic
ASSISTANT_BASE_URL=http://127.0.0.1:11434/v1
ASSISTANT_MODEL=qwen2.5:7b
ASSISTANT_API_KEY=
# 0 for repeatable runs; leave empty for models that accept only their default temperature.
ASSISTANT_TEMPERATURE=0
# A model provider stays unavailable until its data handling is recorded here (a docs anchor).
ASSISTANT_PROVIDER_TERMS=
# Outside demo mode, nothing goes to any provider until data processing is approved.
ASSISTANT_REAL_DATA_APPROVED=false
ASSISTANT_TIMEOUT_MS=90000
ASSISTANT_MAX_PAGES=50
# Kinds below the accuracy bar for this provider (see the evaluation in docs/assistant.md).
ASSISTANT_HIDDEN_KINDS=passage
# Kinds that met the bar for Kiswahili and mixed-language documents; empty shows the notice.
ASSISTANT_OTHER_LANGUAGE_KINDS=
